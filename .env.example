# Production-safe defaults. Keep real secrets (tunnel token) only on the deployment host.
#
# Network: "testnet" (chain id 46630) or "mainnet" (chain id 4663).
# Both are read-only; write capability is hard-disabled in code.
ROBINHOOD_CHAIN_NETWORK=testnet
ROBINHOOD_CHAIN_TIMEOUT_SECONDS=5
#
# Optional Chainlink feed map consumed by /chain/robinhood/asset-config/<SYMBOL>.
# Keys are token symbols; values are the feed PROXY address and its heartbeat.
# The canonical address list is maintained by Chainlink:
# https://docs.chain.link/data-feeds/price-feeds/addresses?network=robinhood
ROBINHOOD_CHAIN_PRICE_FEEDS_JSON={"MSFT": {"address": "0x45C3C877C15E6BA2EBB19eA114Ea508d14C1Af2E", "heartbeat_seconds": 86400}}
#
# The Privy app id is inlined into the frontend bundle at build time, so changing
# it requires rebuilding the frontend image (docker compose up -d --build frontend).
VITE_PRIVY_APP_ID=replace-with-your-privy-app-id
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-metakina-prod-tunnel-token
