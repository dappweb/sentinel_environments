{
  "id": "micromail-cc-relative-active",
  "environment": "micromail",
  "start_page": "HOST_ADDRESS/micromail",
  "prompt": "Monitor the inbox. When 10 new emails where you are CC'd have arrived since the session started, forward all CC emails, then log out.",
  "duration": 120,
  "events": [
    {
      "time": 0,
      "type": "preload_emails",
      "payload": {
        "email_ids": [
          "cc-01",
          "cc-02",
          "cc-03"
        ]
      }
    },
    {
      "time": 9,
      "type": "new_email",
      "payload": {
        "email_id": "cc-04"
      }
    },
    {
      "time": 24,
      "type": "new_email",
      "payload": {
        "email_id": "cc-05"
      }
    },
    {
      "time": 33,
