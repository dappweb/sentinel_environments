      "time": 119,
      "type": "new_email",
      "payload": {
        "email_id": "cc-13"
      }
    }
  ],
  "annotator_notes": "",
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "relative",
    "event_persistence": "persistent",
    "monitoring_approach": "active",
    "difficulty": "easy",
    "distraction_level": "low"
  },
  "eval_sql": "SELECT (SELECT COUNT(*) FROM emails e JOIN email_states s ON e.id=s.email_id WHERE e.isCC=1 AND s.folder='inbox') - CAST((SELECT value FROM session_meta WHERE key='baseline_cc_count') AS REAL) >= 10"
}
