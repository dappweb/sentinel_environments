  "annotator_notes": "",
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "relative",
    "event_persistence": "persistent",
    "monitoring_approach": "passive",
    "difficulty": "easy",
    "distraction_level": "low"
  },
  "eval_sql": "SELECT (SELECT COUNT(*) FROM emails e JOIN email_states s ON e.id=s.email_id WHERE e.isExternal=1 AND s.folder='inbox') - CAST((SELECT value FROM session_meta WHERE key='baseline_external_count') AS REAL) >= 10"
}
