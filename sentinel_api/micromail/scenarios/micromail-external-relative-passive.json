{
  "id": "micromail-external-relative-passive",
  "environment": "micromail",
  "start_page": "HOST_ADDRESS/micromail",
  "prompt": "Monitor the inbox. When 10 new external emails have arrived since the session started, log out.",
  "duration": 120,
  "events": [
    {
      "time": 0,
      "type": "preload_emails",
      "payload": {
        "email_ids": [
          "ext-01",
          "ext-02",
          "ext-03"
        ]
      }
    },
    {
      "time": 9,
      "type": "new_email",
      "payload": {
        "email_id": "ext-04"
      }
    },
    {
