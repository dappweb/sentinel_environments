{
  "id": "micromail-unread-relative-active",
  "environment": "micromail",
  "start_page": "HOST_ADDRESS/micromail",
  "prompt": "Monitor the inbox. When 15 new unread emails have arrived since the session started, mark all as read, then log out.",
  "duration": 120,
  "events": [
    {
      "time": 0,
      "type": "preload_emails",
      "payload": {
        "email_ids": [
          "base-01",
          "base-02",
          "base-03"
        ]
      }
    },
