{
  "id": "micromail-attachment-relative-passive",
  "environment": "micromail",
  "start_page": "HOST_ADDRESS/micromail",
  "prompt": "Monitor the inbox. When 10 new emails with attachments have arrived since the session started, log out.",
  "duration": 120,
  "events": [
    {
      "time": 0,
      "type": "preload_emails",
      "payload": {
        "email_ids": [
          "att-01",
          "att-02",
          "att-03"
        ]
      }
    },
    {
      "time": 9,
      "type": "new_email",
      "payload": {
        "email_id": "att-04"
      }
    },
    {
      "time": 25,
