{
  "id": "micromail-junk-relative-passive",
  "environment": "micromail",
  "start_page": "HOST_ADDRESS/micromail",
  "prompt": "Monitor the junk folder. When 10 new emails have arrived in junk since the session started, log out.",
  "duration": 120,
  "events": [
    {
      "time": 0,
      "type": "preload_emails",
      "payload": {
        "email_ids": [
          "junk-01",
          "junk-02",
          "junk-03"
        ]
      }
    },
    {
      "time": 12,
      "type": "new_email",
      "payload": {
        "email_id": "junk-04"
      }
    },
