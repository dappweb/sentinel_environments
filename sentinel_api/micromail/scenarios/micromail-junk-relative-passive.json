  ],
  "annotator_notes": "",
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "relative",
    "event_persistence": "persistent",
    "monitoring_approach": "passive",
    "difficulty": "easy",
    "distraction_level": "low"
  },
  "eval_sql": "SELECT (SELECT COUNT(*) FROM email_states WHERE folder='junk') - CAST((SELECT value FROM session_meta WHERE key='baseline_junk_count') AS REAL) >= 10"
}
