{
  "id": "micromail-inbox-relative-passive",
  "environment": "micromail",
  "start_page": "HOST_ADDRESS/micromail",
  "prompt": "Monitor the inbox. When the inbox count has grown by 50% from the starting count, log out.",
  "duration": 120,
  "events": [
    {
      "time": 0,
      "type": "preload_emails",
      "payload": {
        "email_ids": [
          "base-01",
          "base-02",
          "base-03",
          "base-04",
          "base-05",
          "base-06",
          "base-07",
          "base-08",
          "base-09",
          "base-10"
        ]
      }
    },
    {
      "time": 23,
      "type": "new_email",
      "payload": {
        "email_id": "base-11"
      }
    },
    {
      "time": 54,
      "type": "new_email",
      "payload": {
        "email_id": "base-12"
      }
    },
    {
      "time": 70,
      "type": "new_email",
      "payload": {
        "email_id": "base-13"
      }
    },
    {
      "time": 99,
      "type": "new_email",
      "payload": {
        "email_id": "base-14"
      }
    },
    {
      "time": 115,
      "type": "new_email",
      "payload": {
        "email_id": "base-15"
      }
    }
  ],
  "annotator_notes": "",
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "relative",
    "event_persistence": "persistent",
    "monitoring_approach": "passive",
    "difficulty": "easy",
    "distraction_level": "low"
  },
  "eval_sql": "SELECT CASE WHEN CAST((SELECT value FROM session_meta WHERE key='baseline_inbox_count') AS REAL) = 0 THEN (SELECT COUNT(*) FROM email_states WHERE folder='inbox') >= 20 ELSE (SELECT COUNT(*) FROM email_states WHERE folder='inbox') >= CAST((SELECT value FROM session_meta WHERE key='baseline_inbox_count') AS REAL) * 1.5 END"
}
