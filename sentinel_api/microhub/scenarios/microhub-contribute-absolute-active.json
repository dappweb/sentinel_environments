{
  "id": "microhub-contribute-absolute-active",
  "environment": "microhub",
  "start_page": "HOST_ADDRESS/microhub",
  "prompt": "You are using MicroHub, a code repository platform. Add a comment to any open issue, then sign out of the application.",
