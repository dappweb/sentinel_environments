# Sentinel Environments .gitignore
# =======================

# Operating System Files
# -----------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.AppleDouble
.LSOverride
Icon
.fuse_hidden*
.directory
.Trash-*
.nfs*

# IDE and Editor Files
# --------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
*~
.vim/
.emacs.d/
.sublime-*

# Node.js and JavaScript
# ----------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.eslintcache
.yarn-integrity
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
yarn.lock
pnpm-lock.yaml

# Build outputs
# -------------
.vite/
dist/
dist-ssr/
build/
out/
coverage/
.nyc_output
.cache/
.parcel-cache/
.next/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.wrangler/

# Environment and Configuration
# -----------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
config.local.js
config.local.json

# Python
# ------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
venv/
env/
ENV/
env.bak/
.venv/
venv.bak/

# Database files (built from JSONL catalogs via build_db.py)
# ---------------------------------------------------------
*.db
*.db-journal
*.sqlite3
*.sqlite

# Credentials
# -----------
credentials.json
token.json
service-account-key.json
*-credentials.json
google-api-*.json

# Logs and Temporary Files
# -------------------------
logs/
.tmp/
.temp/
*.tmp
*.temp
*.log
*.pid
*.seed
*.pid.lock
.sass-cache/

# Backup Files
# ------------
*.bak
*.backup
*.old

# Documentation Build
# -------------------
/docs/
docs/_build/
site/
.docusaurus/

# Testing
# -------
.jest/
junit.xml
coverage.xml
test-results/
results/

# Jupyter Notebooks
# ------------------
.ipynb_checkpoints/

# Deployment
# ----------
.vercel
.netlify/

# Large media files (except those in frontend/public/ and data/public/)
# ---------------------------------------------------------
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.webm
*.mkv
*.m4v
!favicon.*
!logo.*
!icon.*
!*.svg
!frontend/public/**
!data/public/**

# Re-ignore Jupyter checkpoints that the !data/public/** rule would otherwise bring back.
data/public/**/.ipynb_checkpoints/

# Generation scratch (intermediate outputs; installed copies live under data/public/)
data_generation/_generated/

# AI tools
# --------
.claude/
.codex/
.gemini/
.mcp.json
