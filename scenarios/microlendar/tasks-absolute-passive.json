{
  "id": "microlendar-tasks-absolute-passive",
  "environment": "microlendar",
  "start_page": "HOST_ADDRESS/microlendar",
  "prompt": "Keep an eye on my tasks and tell me when the list reaches 10 items.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {
      "time": 0,
      "type": "preload_events",
      "payload": {
        "event_ids": [
          "evt001",
          "evt002",
          "evt003",
          "evt004",
          "evt005",
          "evt006",
          "evt007",
          "evt008",
          "evt009",
          "evt010"
        ],
        "task_ids": [
          "task01",
          "task02",
          "task03",
          "task04",
          "task05",
          "task06",
          "task07",
          "task08"
        ]
      }
    },
    {
      "time": 150,
      "type": "new_task",
      "payload": {
        "event_id": "task09"
      }
    },
    {
      "time": 250,
      "type": "new_event",
      "payload": {
        "event_id": "noise01"
      }
    },
    {
      "time": 300,
      "type": "new_task",
      "payload": {
        "event_id": "task10"
      }
    },
    {
      "time": 375,
      "type": "new_event",
      "payload": {
        "event_id": "today01"
      }
    },
    {
      "time": 450,
      "type": "new_event",
      "payload": {
        "event_id": "today02"
      }
    }
  ],
  "annotator_notes": "",
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "absolute",
    "event_persistence": "persistent",
    "monitoring_approach": "passive",
    "difficulty": "easy",
    "distraction_level": "medium"
  },
  "eval_sql": "SELECT (SELECT (SELECT COUNT(*) FROM tasks t JOIN task_states s ON t.id=s.task_id WHERE s.deleted=0) + (SELECT COUNT(*) FROM user_created_tasks WHERE deleted=0)) >= 10"
}
