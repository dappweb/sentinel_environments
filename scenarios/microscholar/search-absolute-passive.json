{
  "id": "microscholar-search-absolute-passive",
  "environment": "microscholar",
  "start_page": "HOST_ADDRESS/microscholar",
  "prompt": "Keep an eye on these search results and tell me if 'Autonomous AI Agents for Complex Task Execution' shows up.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {
      "time": 0,
      "type": "preload_papers",
      "payload": {
        "paper_ids": [
          "paper-001",
          "paper-002",
          "paper-003",
          "paper-004",
          "paper-005",
          "paper-006",
          "paper-007",
          "paper-008",
          "paper-009",
          "paper-010",
          "paper-011",
          "paper-012",
          "paper-013",
          "paper-014",
          "paper-015",
          "paper-016",
          "paper-017",
          "paper-018",
          "paper-019",
          "paper-020"
        ]
      }
    },
    {
      "time": 100,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-021"
      }
    },
    {
      "time": 200,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-022"
      }
    },
    {
      "time": 300,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-target-1"
      }
    },
    {
      "time": 450,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-023"
      }
    }
  ],
  "annotator_notes": "",
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "absolute",
    "event_persistence": "persistent",
    "monitoring_approach": "passive",
    "difficulty": "easy",
    "distraction_level": "low"
  },
  "eval_sql": "SELECT EXISTS(SELECT 1 FROM papers WHERE id='paper-target-1')"
}
