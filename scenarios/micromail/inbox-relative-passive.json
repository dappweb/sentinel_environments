{
  "id": "micromail-inbox-relative-passive",
  "environment": "micromail",
  "start_page": "HOST_ADDRESS/micromail",
  "prompt": "I already have a few emails. Let me know when 5 more show up in my inbox.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {"time": 0, "type": "preload_emails", "payload": {"email_ids": ["base-01", "base-02", "base-03", "base-04", "base-05"]}},
    {"time": 40, "type": "new_email", "payload": {"email_id": "base-06"}},
    {"time": 100, "type": "new_email", "payload": {"email_id": "base-07"}},
    {"time": 170, "type": "new_email", "payload": {"email_id": "base-08"}},
    {"time": 240, "type": "new_email", "payload": {"email_id": "base-09"}},
    {"time": 300, "type": "new_email", "payload": {"email_id": "base-10"}},
    {"time": 380, "type": "new_email", "payload": {"email_id": "base-11"}},
    {"time": 460, "type": "new_email", "payload": {"email_id": "base-12"}},
    {"time": 540, "type": "new_email", "payload": {"email_id": "base-14"}}
  ],
  "taxonomy": {
    "milestone_type": "relative",
    "monitoring_approach": "passive"
  },
  "eval_sql": "SELECT (SELECT COUNT(*) FROM email_states WHERE folder='inbox') >= (SELECT CAST(value AS INTEGER) FROM session_meta WHERE key='baseline_inbox_count') + 5"
}
