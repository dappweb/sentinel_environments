{
  "id": "micromail-unread-absolute-passive",
  "environment": "micromail",
  "start_page": "HOST_ADDRESS/micromail",
  "prompt": "Tell me when I have 10 unread emails.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {"time": 20, "type": "new_email", "payload": {"email_id": "base-01"}},
    {"time": 50, "type": "new_email", "payload": {"email_id": "base-02"}},
    {"time": 80, "type": "new_email", "payload": {"email_id": "base-03"}},
    {"time": 110, "type": "new_email", "payload": {"email_id": "base-04"}},
    {"time": 140, "type": "new_email", "payload": {"email_id": "base-05"}},
    {"time": 170, "type": "new_email", "payload": {"email_id": "base-06"}},
    {"time": 200, "type": "new_email", "payload": {"email_id": "base-07"}},
    {"time": 240, "type": "new_email", "payload": {"email_id": "base-08"}},
    {"time": 270, "type": "new_email", "payload": {"email_id": "base-09"}},
    {"time": 300, "type": "new_email", "payload": {"email_id": "base-10"}},
    {"time": 370, "type": "new_email", "payload": {"email_id": "base-11"}},
    {"time": 440, "type": "new_email", "payload": {"email_id": "base-12"}},
    {"time": 510, "type": "new_email", "payload": {"email_id": "base-14"}},
    {"time": 580, "type": "new_email", "payload": {"email_id": "base-15"}}
  ],
  "taxonomy": {
    "milestone_type": "absolute",
    "monitoring_approach": "passive"
  },
  "eval_sql": "SELECT (SELECT COUNT(*) FROM emails e JOIN email_states es ON e.id=es.email_id WHERE es.isRead=0 AND es.folder='inbox') >= 10"
}
